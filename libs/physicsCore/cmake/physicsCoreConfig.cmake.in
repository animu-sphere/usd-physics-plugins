@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/physicsCoreCompatibility.cmake")
physics_core_toolchain_id(_physicsCore_toolchain)
if(NOT _physicsCore_toolchain STREQUAL "@PHYSICSCORE_TOOLCHAIN_ID@")
  message(FATAL_ERROR "physicsCore: incompatible compiler/platform/MSVC runtime configuration")
endif()
physics_core_header_id("@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/usd_physics/core" _physicsCore_headers)
if(NOT _physicsCore_headers STREQUAL "@PHYSICSCORE_HEADER_ID@")
  message(FATAL_ERROR "physicsCore: installed headers do not match the package descriptor identity")
endif()
if(TARGET physicsCore::physicsCore)
  physics_core_require_abi("@PHYSICSCORE_ABI_ID@" physicsCore)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/physicsCoreTargets.cmake")
set_property(TARGET physicsCore::physicsCore PROPERTY USDPHYSICS_ABI_ID "@PHYSICSCORE_ABI_ID@")
set(physicsCore_PACKAGE_CONTRACT_VERSION 1)
set(physicsCore_DAMPING_RESPONSE_VERSION 1)
check_required_components(physicsCore)
