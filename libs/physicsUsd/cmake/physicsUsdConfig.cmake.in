@PACKAGE_INIT@
set(_physicsUsd_include_root "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
include(CMakeFindDependencyMacro)
find_dependency(physicsCore 0.1 CONFIG)
if(NOT COMMAND physics_core_require_abi)
  message(FATAL_ERROR "physicsUsd requires rebuilt physicsCore package compatibility metadata")
endif()
physics_core_require_abi("@PHYSICSUSD_CORE_ABI_ID@" physicsUsd)
physics_core_header_id("${_physicsUsd_include_root}/usd_physics/usd" _physicsUsd_headers)
if(NOT _physicsUsd_headers STREQUAL "@PHYSICSUSD_HEADER_ID@")
  message(FATAL_ERROR "physicsUsd: installed headers do not match the package descriptor identity")
endif()
find_dependency(pxr CONFIG)
physics_core_header_id("${PXR_INCLUDE_DIRS}/pxr" _physicsUsd_pxr_headers)
if(NOT PXR_VERSION STREQUAL "@PHYSICSUSD_PXR_VERSION@" OR
   NOT _physicsUsd_pxr_headers STREQUAL "@PHYSICSUSD_PXR_HEADER_ID@")
  message(FATAL_ERROR "physicsUsd: incompatible OpenUSD version/header configuration")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/physicsUsdTargets.cmake")
set(physicsUsd_PACKAGE_CONTRACT_VERSION 1)
